# ESP32-S3 boards: T-Display-S3 (Nerd family) and Bitaxe Gamma. 16 MB flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="/Users/Oliver/code/dvb-WarpAxe/firmware/warpaxe/partitions.csv"
# PSRAM: octal on the T-Display-S3 (S3R8).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16000
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_FREERTOS_HZ=1000
# Console on USB-Serial/JTAG until TinyUSB takes the PHY.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# USB: CDC-NCM network + CDC-ACM console/command port.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x4005
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="dvb-projekt"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="WarpAxe"
CONFIG_TINYUSB_DESC_CDC_STRING="WarpAxe console"
CONFIG_TINYUSB_DEBUG_LEVEL=1
CONFIG_TINYUSB_TASK_STACK_SIZE=6144
CONFIG_TINYUSB_MODE_DMA=y
# More NCM transfer blocks in flight: one per direction loses ACKs under load.
CONFIG_LWIP_DHCPS=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=6144
# A panic writes a core dump to flash and reboots; the next boot shows it.
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=16
CONFIG_ESP_HTTPD_MAX_URI_LEN=128
CONFIG_ESP_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# mbedTLS (Stratum TLS/Sv2, online update, price fetch) allocates from
# PSRAM: with its buffers in the small internal RAM, an hour of mining on
# TLS left too little contiguous memory for the RSA check of a server
# certificate (-0x4290, MPI alloc) and the online update failed.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
