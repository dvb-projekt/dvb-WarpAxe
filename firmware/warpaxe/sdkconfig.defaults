# ESP32-S3 boards: T-Display-S3 (Nerd family) and Bitaxe Gamma. 16 MB flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="/Users/Oliver/code/dvb-WarpAxe/firmware/warpaxe/partitions.csv"
# PSRAM: octal on the T-Display-S3 (S3R8).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16000
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_FREERTOS_HZ=1000
# Console on USB-Serial/JTAG until TinyUSB takes the PHY.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# USB: CDC-NCM network + CDC-ACM console/command port.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x4005
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="dvb-projekt"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="WarpAxe"
CONFIG_TINYUSB_DESC_CDC_STRING="WarpAxe console"
CONFIG_TINYUSB_DEBUG_LEVEL=1
CONFIG_TINYUSB_TASK_STACK_SIZE=6144
CONFIG_TINYUSB_MODE_DMA=y
# More NCM transfer blocks in flight: one per direction loses ACKs under load.
CONFIG_LWIP_DHCPS=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=6144
# 16 instead of the default 10: the HTTP server holds up to five, the
# pool one, mDNS two; the swarm page's search for an Avalon opens four
# at a time on top (swarm.rs), and a scan must not starve the rest.
CONFIG_LWIP_MAX_SOCKETS=16
# A panic writes a core dump to flash and reboots; the next boot shows it.
# The dump is an ELF of every task's used stack and registers, 60-64 KB on
# this firmware, and the writer stores nothing when it would not fit the
# coredump partition (partitions.csv: 256 KB since v0.1.37, 64 KB before).
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=16
# The interrupt watchdog is fed only while both CPUs tick. Every flash
# write or erase stalls CPU1 and holds CPU0's non-IRAM interrupts for its
# length, so a sector erase longer than the timeout is an int-wdt reset,
# with no core dump (the chip is still busy when the writer tries). ESP-IDF
# allows a sector erase 600 ms (GD25Q127 at 125 C), the default timeout is
# 300 ms: a Gamma hit it in an NVS write right before the reset after an
# upload, 39 minutes warm (2026-10-23, docs/12). 1000 ms covers every
# sector erase and the usual block erase of the update's slot; a real
# interrupt hang still resets within a second (stage 2 at two seconds).
CONFIG_ESP_INT_WDT_TIMEOUT_MS=1000
# Ethernet over the W5500 HAT (NerdHat, docs/13): the SPI MAC+PHY driver of
# esp_eth, and with it esp-idf-svc's `SpiEthChipset::W5500`. Compiled into
# the one image for every board; used only where the board profile names
# the HAT's pins and a W5500 answers at boot (net/eth.rs).
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_ESP_HTTPD_MAX_URI_LEN=128
CONFIG_ESP_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# mbedTLS (Stratum TLS/Sv2, online update, price fetch) allocates from
# PSRAM: with its buffers in the small internal RAM, an hour of mining on
# TLS left too little contiguous memory for the RSA check of a server
# certificate (-0x4290, MPI alloc) and the online update failed.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Trust only the pinned CA bundle (certificates/README.md): the ESP-IDF
# lists of v5.3.3 still carry the roots removed after the eMudhra incident,
# and a custom bundle is added to them, not put in their place. The path is
# relative to the ESP-IDF project directory esp-idf-sys generates, six levels
# below this crate (target/<triple>/<profile>/build/esp-idf-sys-*/out);
# tools/check-ca-bundle.py --build-dir checks the result.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_NONE=y
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEPRECATED_LIST is not set
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="../../../../../../certificates/cacert-2026-10-20.pem"
# A new app must mark itself valid once it runs (update::mark_app_valid at
# chain ready, or after three minutes); a crash or boot loop before that
# makes the bootloader start the previous app instead. The bootloader must
# be reflashed over USB once for this to take effect (an OTA never touches it).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
