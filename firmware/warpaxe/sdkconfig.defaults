# ESP32-S3 boards: T-Display-S3 (Nerd family) and Bitaxe Gamma. 16 MB flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="/Users/Oliver/code/dvb-WarpAxe/firmware/warpaxe/partitions.csv"
# PSRAM: octal on the T-Display-S3 (S3R8).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16512
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_FREERTOS_HZ=1000
# Console on USB-Serial/JTAG until TinyUSB takes the PHY.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# USB: CDC-NCM network + CDC-ACM console/command port.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x4005
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="dvb-projekt"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="WarpAxe"
CONFIG_TINYUSB_DESC_CDC_STRING="WarpAxe console"
CONFIG_TINYUSB_DEBUG_LEVEL=1
CONFIG_TINYUSB_TASK_STACK_SIZE=6144
CONFIG_TINYUSB_MODE_DMA=y
# More NCM transfer blocks in flight: one per direction loses ACKs under load.
CONFIG_LWIP_DHCPS=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=6656
# 16 instead of the default 10: the HTTP server holds up to five, the
# pool one, mDNS two; the swarm page's search for an Avalon opens four
# at a time on top (swarm.rs), and a scan must not starve the rest.
CONFIG_LWIP_MAX_SOCKETS=16
# IPv6 for pool connections (docs/17): the station takes its global and
# unique-local addresses from the router's advertisements (SLAAC). Used
# only while the ipv6 setting is on; then a pool's AAAA records are
# tried first, IPv4 a quarter second later (net/dial.rs).
CONFIG_LWIP_IPV6_AUTOCONFIG=y
# A panic writes a core dump to flash and reboots; the next boot shows it.
# The dump is an ELF of every task's used stack and registers, 60-64 KB on
# this firmware, and the writer stores nothing when it would not fit the
# coredump partition (partitions.csv: 256 KB since v0.1.37, 64 KB before).
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=16
# The interrupt watchdog is fed only while both CPUs tick. Every flash
# write or erase stalls CPU1 and holds CPU0's non-IRAM interrupts for its
# length, so a sector erase longer than the timeout is an int-wdt reset,
# with no core dump (the chip is still busy when the writer tries). ESP-IDF
# allows a sector erase 600 ms (GD25Q127 at 125 C), the default timeout is
# 300 ms: a Gamma hit it in an NVS write right before the reset after an
# upload, 39 minutes warm (2026-10-23, docs/12). 1000 ms covers every
# sector erase and the usual block erase of the update's slot; a real
# interrupt hang still resets within a second (stage 2 at two seconds).
CONFIG_ESP_INT_WDT_TIMEOUT_MS=1000
CONFIG_ESP_HTTPD_MAX_URI_LEN=128
CONFIG_ESP_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# printf, snprintf and every ESP_LOG line through newlib's nano formatter
# (docs/16, "ROM printf"): 44 KB less image. Nano knows only the h, l
# and L length modifiers: %lld, %llu, PRIu64, %zu, %jd and positional
# %1$ print the letters and take no argument, so every argument after
# them shifts. Our C uses none; the ESP-IDF and Wi-Fi strings in the
# image that do are listed in docs/16 (log wording only). On the S3 the
# formatter comes from the toolchain's libc_nano in flash, not from ROM:
# the ROM copy was built with a 32-bit time_t.
CONFIG_NEWLIB_NANO_FORMAT=y
# With nano ESP-IDF gives its tasks 512 bytes less stack
# (TASK_EXTRA_STACK_SIZE in esp_task.h, TASK_STACK_SIZE_ADD in the
# supplicant): its printf needs less. Four of them run here, and Rust
# code runs on three (the main task, the event loop's handlers, the
# esp_timer callbacks) without formatting through printf, so the 512
# bytes go back and every stack stays as large as before: main task
# 16000 -> 16512 and tcpip 6144 -> 6656 above, these two from their
# defaults 2304 and 3584. (Ping, WPS, DPP and the enterprise task are
# not linked.) The Wi-Fi blob's own task would lose 512 bytes the same
# way through wifi_init_config_t.nano_enable; the vendored esp-idf-svc
# passes 0 there (vendor/esp-idf-svc/WARPAXE-PATCH.md, 4.).
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2816
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096

# mbedTLS (Stratum TLS/Sv2, online update, price fetch) allocates from
# PSRAM: with its buffers in the small internal RAM, an hour of mining on
# TLS left too little contiguous memory for the RSA check of a server
# certificate (-0x4290, MPI alloc) and the online update failed.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Trust only the pinned CA bundle (certificates/README.md): the ESP-IDF
# lists of v5.3.3 still carry the roots removed after the eMudhra incident,
# and a custom bundle is added to them, not put in their place. The path is
# relative to the ESP-IDF project directory esp-idf-sys generates, six levels
# below this crate (target/<triple>/<profile>/build/esp-idf-sys-*/out);
# tools/check-ca-bundle.py --build-dir checks the result.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_NONE=y
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEPRECATED_LIST is not set
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="../../../../../../certificates/ca-bundle.pem"
# Check each certificate's validity window against the clock. Without a
# clock NTP set this boot the date faults are dropped again in the verify
# callbacks (firmware/warpaxe/src/tls_trust.rs), so a miner without NTP
# connects as before; tools/check-ca-bundle.py --build-dir checks it is on.
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
# A new app must mark itself valid once it runs (update::mark_app_valid at
# chain ready, or after three minutes); a crash or boot loop before that
# makes the bootloader start the previous app instead. The bootloader must
# be reflashed over USB once for this to take effect (an OTA never touches it).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Internal RAM (docs/20). On the ESP32-S3 IRAM and DRAM share the same
# SRAM: every byte of code placed in IRAM is a byte less of internal heap.
# The Wi-Fi blob's hot paths stay in flash (7,168 + 9,728 bytes): Wi-Fi
# throughput falls, which a miner's few KB/s of Stratum never feel; the
# Wi-Fi interrupt itself is in IRAM either way. Espressif's own list of
# IRAM savings (api-guides/performance/ram-usage).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# FreeRTOS' and the ring buffer's task-side functions in flash (8,960 +
# 1,280 bytes); their ...FromISR halves and the scheduler stay in IRAM.
# Espressif: safe in every configuration as long as no ISR calls the task
# variants. Our only IRAM code (warpaxe_glue.c: last words, the stack
# overflow hook; warpaxe_cpuhash.c and warpaxe_shabench.c: the devkit's
# hash loops) calls none.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
# mDNS: its task (4 KB stack) and every record and packet it allocates in
# PSRAM instead of explicitly internal RAM. It runs on the network only
# (lwIP callbacks, its own task, an esp_timer that posts to its queue)
# and touches no flash. On .41 with the W5500 HAT the internal heap ran
# dry and mDNS allocations were among those that failed (2026-11-21).
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
# The heap allocator in flash (6,656 bytes). Espressif: safe unless an ISR
# calls heap functions. Kconfig turns CONFIG_SPI_MASTER_ISR_IN_IRAM off
# with it (that option depends on !HEAP_PLACE_FUNCTION_INTO_FLASH), which
# is what the Ethernet build wants anyway (f58f70b). We install no IRAM
# interrupt; the i80 frame callback allocates nothing.
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
# The .bss of lwIP, the Wi-Fi libraries (net80211, pp) and
# wpa_supplicant in PSRAM: 14,308 bytes (ESP-IDF moves those libraries'
# .bss by itself with this option; nothing of ours is marked
# EXT_RAM_BSS_ATTR). ESP-Miner and
# NerdOS both ship it ("saves about 14kB internal RAM", NerdOS
# sdkconfig.defaults; ESP-Miner #1280).
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
